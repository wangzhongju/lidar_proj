void SyncNode::saveData(const std::string& image_topic, const std::string& pointcloud_topic) {
  // 获取时间戳
  ros::Time image_time = last_images_[image_topic]->header.stamp;
  ros::Time pointcloud_time = last_pointclouds_[pointcloud_topic]->header.stamp;

  // 为每个话题创建独立的文件夹
  std::string image_folder = output_directory_ + "/" + image_topic.substr(1);  // 去除话题前缀“/”
  std::string pointcloud_folder = output_directory_ + "/" + pointcloud_topic.substr(1);  // 同样去除话题前缀“/”
  
  // 创建文件夹
  if (mkdir(image_folder.c_str(), 0777) == -1 && errno != EEXIST) {
    ROS_ERROR("Failed to create directory: %s", image_folder.c_str());
    return;
  }
  if (mkdir(pointcloud_folder.c_str(), 0777) == -1 && errno != EEXIST) {
    ROS_ERROR("Failed to create directory: %s", pointcloud_folder.c_str());
    return;
  }

  // 保存图像
  try {
    const sensor_msgs::CompressedImageConstPtr& image = last_images_[image_topic];
    cv_bridge::CvImagePtr cv_ptr = cv_bridge::toCvCopy(image, sensor_msgs::image_encodings::BGR8);  // 解码压缩图像
    std::string image_filename = image_folder + "/image_" + std::to_string(pointcloud_time.toSec()) + ".png";
    cv::imwrite(image_filename, cv_ptr->image);
    ROS_INFO("Saved image: %s", image_filename.c_str());
  } catch (cv_bridge::Exception& e) {
    ROS_ERROR("Could not convert image: %s", e.what());
  }

  // 保存点云
  const sensor_msgs::PointCloud2ConstPtr& pointcloud = last_pointclouds_[pointcloud_topic];
  pcl::PointCloud<pcl::PointXYZ> cloud;
  pcl::fromROSMsg(*pointcloud, cloud);
  std::string pointcloud_filename = pointcloud_folder + "/cloud_" + std::to_string(pointcloud_time.toSec()) + ".pcd";
  pcl::io::savePCDFileBinary(pointcloud_filename, cloud);
  ROS_INFO("Saved pointcloud: %s", pointcloud_filename.c_str());
}


int main(int argc, char** argv) {
  ros::init(argc, argv, "sync_node");
  ros::NodeHandle nh;
  SyncNode sync_node(nh);
  ros::spin();
  return 0;
}