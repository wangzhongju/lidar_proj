void SyncNode::processData() {
  // 检查所有图像和点云话题是否都有数据
//   if (last_images_.size() != image_topics_.size() || last_pointclouds_.size() != pointcloud_topics_.size()) {
  if (last_images_.empty() || last_pointclouds_.empty()) {
    // ROS_WARN("empty data...");
    return;  // 如果数据未完全准备好，返回
  }

  // 计算所有图像和点云之间的时间差
  std::map<std::string, ros::Time> image_times;
  std::map<std::string, ros::Time> pointcloud_times;
  for (const auto& entry : last_images_) {
    image_times[entry.first] = entry.second->header.stamp;
  }
  for (const auto& entry : last_pointclouds_) {
    pointcloud_times[entry.first] = entry.second->header.stamp;
  }

  // 找到最小时间差
  double min_time_diff = std::numeric_limits<double>::max();
  std::string best_image_topic, best_pointcloud_topic;
  for (const auto& image_entry : image_times) {
    for (const auto& pc_entry : pointcloud_times) {
      double time_diff = abs((image_entry.second - pc_entry.second).toSec());
      if (time_diff < min_time_diff) {
        min_time_diff = time_diff;
        best_image_topic = image_entry.first;
        best_pointcloud_topic = pc_entry.first;
      }
    }
  }

  // 如果最小时间差小于设定的间隔，则保存数据
  if (min_time_diff < save_interval_) {
    saveData(best_image_topic, best_pointcloud_topic);
    // 清空已保存的数据
    last_images_.erase(best_image_topic);
    last_pointclouds_.erase(best_pointcloud_topic);
  }
}

