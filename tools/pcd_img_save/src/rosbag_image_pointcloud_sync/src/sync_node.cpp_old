#include "sync_node.h"
#include <iostream>
#include <fstream>
#include <chrono>
#include <limits>
#include <opencv2/opencv.hpp>

SyncNode::SyncNode(ros::NodeHandle& nh) : nh_(nh) {
  // 获取参数
  nh_.param("save_interval", save_interval_, 0.5);
  nh_.param("output_directory", output_directory_, std::string("/tmp/sync_output"));

  // 获取多个图像话题和点云话题
  nh_.getParam("image_topics", image_topics_);
  nh_.getParam("pointcloud_topics", pointcloud_topics_);

  // 为每个图像和点云话题创建订阅器
  for (const auto& topic : image_topics_) {
    image_subs_[topic] = nh_.subscribe(topic, 1, &SyncNode::imageCallback, this);
  }
  for (const auto& topic : pointcloud_topics_) {
    pointcloud_subs_[topic] = nh_.subscribe(topic, 1, &SyncNode::pointcloudCallback, this);
  }

//   for (const auto& topic : image_topics_) {
//     image_subs_[topic] = nh_.subscribe(topic, 1, 
//         std::bind(&SyncNode::imageCallback, this, _1, topic));
//   }
