//         std::bind(&SyncNode::pointcloudCallback, this, _1, topic));
//   }

//   for (const auto& topic : image_topics_) {
//     image_subs_[topic] = nh_.subscribe(topic, 1, 
//       [this, topic](const sensor_msgs::CompressedImageConstPtr& msg) {
//         this->imageCallback(msg, topic); // 在这里传递topic
